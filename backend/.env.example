# Copy to .env and adjust. Never commit .env.
APP_NAME=Salvis API
DEBUG=false
API_PREFIX=/api

# Postgres via docker-compose; use sqlite for a quick local run.
DATABASE_URL=postgresql+psycopg://salvis:salvis@localhost:5432/salvis

# Generate a strong secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

CORS_ORIGINS=https://harishkgm2007-sudo.github.io,http://localhost:8000,http://localhost:5500

# Dev convenience only - disable in production and use alembic migrations.
AUTO_CREATE_TABLES=true